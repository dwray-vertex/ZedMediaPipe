def main():

    args = parse_args()

    calibs = load_calibration(
        args.calib
    )

    main_serials = [
        sn
        for sn, c in calibs.items()
        if c.name == "main"
    ]

    if len(main_serials) != 1:

        print(
            "[FATAL] Expected exactly one "
            "camera named 'main', "
            f"found {len(main_serials)}."
        )

        sys.exit(1)

    main_sn = (
        main_serials[0]
    )

    res_map = {
        "HD2K": sl.RESOLUTION.HD2K,
        "HD1080": sl.RESOLUTION.HD1080,
        "HD720": sl.RESOLUTION.HD720,
        "VGA": sl.RESOLUTION.VGA
    }

    resolution = (
        res_map[args.resolution]
    )

    mp_hands = (
        mp.solutions.hands
    )

    mp_drawing = (
        mp.solutions.drawing_utils
    )

    mp_styles = (
        mp.solutions.drawing_styles
    )

    workers = {}

    try:

        for sn, calib in calibs.items():

            print(
                f"[info] Opening "
                f"SN={sn} "
                f"name={calib.name} ..."
            )

            worker = CameraWorker(
                sl,
                cv2,
                mp_hands,
                sn,
                calib,
                resolution,
                args.fps,
                args.max_hands,
                args.min_detection_confidence,
                args.min_tracking_confidence,
                args.detect_width,
                args.model_complexity
            )

            workers[sn] = worker

            worker.start()

    except RuntimeError as e:

        print(
            f"[FATAL] {e}"
        )

        for worker in workers.values():
            worker.stop()

        for worker in workers.values():
            worker.join(
                timeout=5.0
            )

        for worker in workers.values():
            worker.close()

        sys.exit(1)

    time.sleep(1.0)

    proj_mats = {}

    for sn, calib in calibs.items():

        if calib.fx is None:

            print(
                "[FATAL] Intrinsics unavailable "
                f"for SN={sn} "
                f"({calib.name})."
            )

            for worker in workers.values():
                worker.stop()

            for worker in workers.values():
                worker.join(
                    timeout=2
                )

            for worker in workers.values():
                worker.close()

            sys.exit(1)

        proj_mats[sn] = (
            build_projection_matrix(
                calib
            )
        )

        print(
            f"[info] {calib.name}: "
            f"fx={calib.fx:.2f}, "
            f"fy={calib.fy:.2f}, "
            f"cx={calib.cx:.2f}, "
            f"cy={calib.cy:.2f}"
        )

    print(
        "[info] Camera centers in MAIN frame:"
    )

    for sn, calib in calibs.items():

        print(
            f"    {calib.name}: "
            f"{calib.center_main}"
        )

    print(
        "[info] MAIN ZED metric XYZ is "
        "enabled by default."
    )

    print(
        "[info] MediaPipe relative Z "
        "will never be used."
    )

    frame_count = 0

    window_name = (
        "Fused multi-view hand tracking"
    )

    last_good_points = {
        "Left": [None] * 21,
        "Right": [None] * 21
    }

    print(
        "[info] Starting fused capture loop. "
        "Press 'q' to quit."
    )

    try:

        while True:

            if (
                args.max_frames is not None
                and frame_count >= args.max_frames
            ):
                break

            latest = {
                sn: worker.get_latest()
                for sn, worker in workers.items()
            }

            # -----------------------------------------------------
            # Group detections by physical handedness.
            # -----------------------------------------------------

            detections_by_label = {
                "Left": [],
                "Right": []
            }

            for sn, data in latest.items():

                results = (
                    data["results"]
                )

                if (
                    results is None
                    or not results.multi_hand_landmarks
                ):
                    continue

                w = data["frame_w"]
                h = data["frame_h"]

                if (
                    w is None
                    or h is None
                ):
                    continue

                for (
                    hand_landmarks,
                    handedness
                ) in zip(
                    results.multi_hand_landmarks,
                    results.multi_handedness,
                ):

                    raw_label = (
                        handedness
                        .classification[0]
                        .label
                    )

                    label = (
                        correct_handedness(
                            raw_label,
                            calibs[sn].name
                        )
                    )

                    hand_score = float(
                        handedness
                        .classification[0]
                        .score
                    )

                    detections_by_label[
                        label
                    ].append(
                        {
                            "sn": sn,
                            "calib": calibs[sn],
                            "landmarks": hand_landmarks,
                            "hand_score": hand_score,
                            "w": w,
                            "h": h,
                            "xyz": data["xyz"],
                            "capture_ts": data["capture_ts"],
                            "frame_id": data["frame_id"]
                        }
                    )

            fused_hands = {}

            for (
                label,
                detections
            ) in detections_by_label.items():

                if not detections:
                    continue

                # -------------------------------------------------
                # Synchronize by capture timestamp.
                # -------------------------------------------------

                newest_ts = max(
                    d["capture_ts"]
                    for d in detections
                )

                sync_limit = (
                    args.max_sync_skew_ms
                    / 1000.0
                )

                synced = [
                    d
                    for d in detections
                    if (
                        newest_ts
                        - d["capture_ts"]
                        <= sync_limit
                    )
                ]

                if not synced:
                    continue

                main_detections = [
                    d
                    for d in synced
                    if d["calib"].name == "main"
                ]

                mono_detections = [
                    d
                    for d in synced
                    if d["calib"].name != "main"
                ]

                # -------------------------------------------------
                # Highest-confidence MAIN detection is primary.
                # -------------------------------------------------

                main_detection = None

                if main_detections:

                    main_detection = max(
                        main_detections,
                        key=lambda d:
                            d["hand_score"]
                    )

                points3d = [
                    None
                ] * 21

                landmark_sources = [
                    "unavailable"
                ] * 21

                landmark_errors = {}

                correction_distances = {}

                mono_view_counts = {}

                # -------------------------------------------------
                # Process each landmark independently.
                # -------------------------------------------------

                for landmark_index in range(21):

                    main_point = None

                    # =================================================
                    # STEP 1
                    #
                    # MAIN MediaPipe pixel
                    #        ↓
                    # ZED XYZ measurement
                    #
                    # This is PRIMARY.
                    # =================================================

                    if main_detection is not None:

                        main_lm = (
                            main_detection[
                                "landmarks"
                            ]
                            .landmark[
                                landmark_index
                            ]
                        )

                        main_point = (
                            get_zed_xyz_point(
                                main_lm,
                                main_detection
                            )
                        )

                    # =================================================
                    # STEP 2
                    #
                    # Gather mono observations.
                    #
                    # They provide rays only.
                    # MediaPipe Z is ignored.
                    # =================================================

                    mono_observations = []

                    for d in mono_detections:

                        lm = (
                            d["landmarks"]
                            .landmark[
                                landmark_index
                            ]
                        )

                        px = (
                            float(lm.x)
                            * float(d["w"])
                        )

                        py = (
                            float(lm.y)
                            * float(d["h"])
                        )

                        quality = (
                            observation_quality(
                                lm,
                                px,
                                py,
                                d["w"],
                                d["h"]
                            )
                        )

                        if quality <= 0.0:
                            continue

                        mono_observations.append(
                            {
                                "sn": d["sn"],
                                "calib": d["calib"],
                                "px": px,
                                "py": py,
                                "quality": quality,
                                "hand_score": d["hand_score"],
                                "capture_ts": d["capture_ts"],
                                "frame_id": d["frame_id"]
                            }
                        )

                    # =================================================
                    # STEP 3
                    #
                    # ZED XYZ exists.
                    #
                    # ZED remains the primary source.
                    #
                    # Mono views may refine it.
                    # =================================================

                    if main_point is not None:

                        if mono_observations:

                            (
                                refined_point,
                                correction,
                                n_mono
                            ) = (
                                refine_point_with_mono_views(
                                    main_point,
                                    mono_observations,
                                    blend=args.mono_refine_blend
                                )
                            )

                            points3d[
                                landmark_index
                            ] = refined_point

                            landmark_sources[
                                landmark_index
                            ] = (
                                "zed_xyz+mono_refined"
                            )

                            correction_distances[
                                landmark_index
                            ] = correction

                            mono_view_counts[
                                landmark_index
                            ] = n_mono

                        else:

                            points3d[
                                landmark_index
                            ] = main_point

                            landmark_sources[
                                landmark_index
                            ] = "zed_xyz"

                        last_good_points[
                            label
                        ][
                            landmark_index
                        ] = (
                            points3d[
                                landmark_index
                            ].copy()
                        )

                        continue

                    # =================================================
                    # STEP 4
                    #
                    # ZED XYZ unavailable.
                    #
                    # Try multi-camera triangulation.
                    # =================================================

                    all_observations = []

                    for d in synced:

                        lm = (
                            d["landmarks"]
                            .landmark[
                                landmark_index
                            ]
                        )

                        px = (
                            float(lm.x)
                            * float(d["w"])
                        )

                        py = (
                            float(lm.y)
                            * float(d["h"])
                        )

                        quality = (
                            observation_quality(
                                lm,
                                px,
                                py,
                                d["w"],
                                d["h"]
                            )
                        )

                        if quality <= 0.0:
                            continue

                        all_observations.append(
                            (
                                proj_mats[
                                    d["sn"]
                                ],
                                px,
                                py,
                                d["sn"]
                            )
                        )

                    if len(
                        all_observations
                    ) >= 2:

                        (
                            point,
                            errors,
                            status
                        ) = fuse_landmark(
                            all_observations,
                            args.min_triangulation_angle_deg,
                            args.reproj_error_threshold_px
                        )

                        if point is not None:

                            points3d[
                                landmark_index
                            ] = point

                            landmark_sources[
                                landmark_index
                            ] = (
                                "multi_view_triangulated"
                            )

                            landmark_errors[
                                landmark_index
                            ] = errors

                            last_good_points[
                                label
                            ][
                                landmark_index
                            ] = point.copy()

                            continue

                    # =================================================
                    # STEP 5
                    #
                    # No metric solution.
                    #
                    # Do NOT use MediaPipe relative Z.
                    # =================================================

                    landmark_sources[
                        landmark_index
                    ] = "unavailable"

                fused_hands[
                    label
                ] = {
                    "points3d": points3d,
                    "source": (
                        "zed_xyz_primary"
                        if main_detection is not None
                        else "triangulation_or_unavailable"
                    ),
                    "n_views": len(synced),
                    "landmark_sources": landmark_sources,
                    "reproj_errs": landmark_errors,
                    "correction_distances": correction_distances,
                    "mono_view_counts": mono_view_counts
                }

            # ---------------------------------------------------------
            # Output
            # ---------------------------------------------------------

            message_payload = {
                "hands": {
                    label: build_finger_dict(
                        data["points3d"],
                        data["landmark_sources"]
                    )
                    for (
                        label,
                        data
                    ) in fused_hands.items()
                }
            }

            send_message(
                message_payload
            )

            print(
                message_payload
            )

            # ---------------------------------------------------------
            # Diagnostics
            # ---------------------------------------------------------

            if frame_count % 30 == 0:

                for (
                    label,
                    data
                ) in fused_hands.items():

                    valid = sum(
                        p is not None
                        for p in data[
                            "points3d"
                        ]
                    )

                    print(
                        f"[frame {frame_count}] "
                        f"{label}: "
                        f"{valid}/21 metric 3D"
                    )

                    source_counts = {}

                    for source in data[
                        "landmark_sources"
                    ]:

                        source_counts[
                            source
                        ] = (
                            source_counts.get(
                                source,
                                0
                            ) + 1
                        )

                    print(
                        f"    sources="
                        f"{source_counts}"
                    )

                    reproj_errs = (
                        data.get(
                            "reproj_errs"
                        )
                        or {}
                    )

                    if isinstance(
                        reproj_errs,
                        dict
                    ):

                        for (
                            idx,
                            errors
                        ) in reproj_errs.items():

                            if not errors:
                                continue

                            error_text = ", ".join(
                                f"SN={sn}:{err:.1f}px"
                                for (
                                    sn,
                                    err
                                ) in errors
                            )

                            if max(
                                err
                                for (
                                    _,
                                    err
                                ) in errors
                            ) > (
                                args.reproj_error_warn_px
                            ):

                                print(
                                    f"      "
                                    f"{LANDMARK_NAMES[idx]}: "
                                    f"{error_text}"
                                )

            # ---------------------------------------------------------
            # Display MAIN camera.
            # ---------------------------------------------------------

            if not args.no_display:

                main_frame_data = (
                    workers[
                        main_sn
                    ].get_latest_frame()
                )

                main_result_data = (
                    latest.get(
                        main_sn
                    )
                )

                if (
                    main_frame_data
                    and main_frame_data[
                        "frame_bgr"
                    ] is not None
                ):

                    display = (
                        main_frame_data[
                            "frame_bgr"
                        ].copy()
                    )

                    results = (
                        main_result_data[
                            "results"
                        ]
                    )

                    if (
                        results
                        and results.multi_hand_landmarks
                    ):

                        for hl in (
                            results.multi_hand_landmarks
                        ):

                            mp_drawing.draw_landmarks(
                                display,
                                hl,
                                mp_hands.HAND_CONNECTIONS,
                                mp_styles.get_default_hand_landmarks_style(),
                                mp_styles.get_default_hand_connections_style()
                            )

                    y = 30

                    for (
                        label,
                        data
                    ) in fused_hands.items():

                        valid = sum(
                            p is not None
                            for p in data[
                                "points3d"
                            ]
                        )

                        cv2.putText(
                            display,
                            (
                                f"{label}: "
                                f"{valid}/21 3D"
                            ),
                            (10, y),
                            cv2.FONT_HERSHEY_SIMPLEX,
                            0.6,
                            (0, 255, 0),
                            2
                        )

                        y += 25

                    cv2.imshow(
                        window_name,
                        display
                    )

                    if (
                        cv2.waitKey(1)
                        & 0xFF
                    ) == ord("q"):

                        break

            frame_count += 1

    except KeyboardInterrupt:

        print(
            "\n[info] Interrupted by user."
        )

    finally:

        for worker in workers.values():
            worker.stop()

        for worker in workers.values():
            worker._tracking_thread.join(
                timeout=3.0
            )

        for worker in workers.values():
            worker._capture_thread.join(
                timeout=5.0
            )

        for worker in workers.values():
            worker.close()

        if not args.no_display:
            cv2.destroyAllWindows()

        print(
            f"[info] Done. "
            f"Processed "
            f"{frame_count} "
            f"main-loop iterations."
        )


if __name__ == "__main__":
    main()
