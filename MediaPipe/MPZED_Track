@dataclass
class CameraCalib:
    serial_number: int
    name: str
    R: np.ndarray
    T: np.ndarray
    fx: Optional[float] = None
    fy: Optional[float] = None
    cx: Optional[float] = None
    cy: Optional[float] = None

    @property
    def center_main(self) -> np.ndarray:
        return self.T.reshape(3).copy()


def load_calibration(path: str):
    with open(path, "r") as f:
        raw = json.load(f)

    calibs = {}

    for name, cam in raw["cameras"].items():

        transform = np.asarray(
            cam["transform_camera_to_main"],
            dtype=np.float64
        )

        R = transform[:3, :3]
        T = transform[:3, 3].reshape(3, 1)

        calibs[cam["serial"]] = CameraCalib(
            serial_number=cam["serial"],
            name=name,
            R=R,
            T=T
        )

    return calibs


def correct_handedness(raw_label: str, calib_name: str) -> str:
    """
    The MAIN camera's MediaPipe handedness is mirrored relative to the
    physical hand. Keep the existing correction only for MAIN.

    Mono cameras retain MediaPipe's label.
    """
    if calib_name == "main":
        return "Right" if raw_label == "Left" else "Left"

    return raw_label


def build_projection_matrix(calib: CameraCalib) -> np.ndarray:
    """
    Build P = K[R|t] mapping a point in MAIN coordinates to camera pixels.

    Calibration stores:

        p_main =
            R_camera_to_main @ p_camera
            + T_camera_to_main

    Therefore:

        p_camera =
            R.T @ (p_main - T)
    """

    K = np.array(
        [
            [calib.fx, 0.0, calib.cx],
            [0.0, calib.fy, calib.cy],
            [0.0, 0.0, 1.0],
        ],
        dtype=np.float64,
    )

    R_main_to_cam = calib.R.T
    T_main_to_cam = -R_main_to_cam @ calib.T

    return K @ np.hstack([
        R_main_to_cam,
        T_main_to_cam
    ])


def camera_center_from_projection(
    P: np.ndarray
) -> np.ndarray:

    _, _, Vt = np.linalg.svd(P)

    c = Vt[-1]

    if abs(c[3]) < 1e-12:
        return np.zeros(3, dtype=np.float64)

    c /= c[3]

    return c[:3]


def triangulation_angle_deg(
    point3d: np.ndarray,
    centers: List[np.ndarray],
) -> float:

    if len(centers) < 2:
        return 0.0

    rays = []

    for c in centers:

        v = point3d - c

        n = np.linalg.norm(v)

        if n < 1e-9:
            continue

        rays.append(v / n)

    if len(rays) < 2:
        return 0.0

    best = 180.0

    for i in range(len(rays)):

        for j in range(i + 1, len(rays)):

            dot = float(
                np.clip(
                    np.dot(rays[i], rays[j]),
                    -1.0,
                    1.0
                )
            )

            angle = np.degrees(
                np.arccos(dot)
            )

            best = min(
                best,
                angle
            )

    return float(best)


def triangulate_point(
    observations: List[
        Tuple[np.ndarray, float, float, int]
    ]
) -> Optional[np.ndarray]:

    """
    Linear DLT triangulation.

    Each observation is:

        (P, pixel_x, pixel_y, serial_number)
    """

    if len(observations) < 2:
        return None

    A = []

    for P, px, py, _ in observations:

        A.append(
            px * P[2, :] - P[0, :]
        )

        A.append(
            py * P[2, :] - P[1, :]
        )

    A = np.asarray(
        A,
        dtype=np.float64
    )

    try:

        _, _, Vt = np.linalg.svd(A)

    except np.linalg.LinAlgError:

        return None

    X = Vt[-1]

    if abs(X[3]) < 1e-10:
        return None

    point = X[:3] / X[3]

    if not np.all(
        np.isfinite(point)
    ):
        return None

    return point


def project_point(
    P: np.ndarray,
    point3d: np.ndarray
):

    p = P @ np.append(
        point3d,
        1.0
    )

    if abs(p[2]) < 1e-10:
        return None

    return p[:2] / p[2]


def reprojection_error_px(
    P: np.ndarray,
    px: float,
    py: float,
    point3d: np.ndarray
) -> float:

    projected = project_point(
        P,
        point3d
    )

    if projected is None:
        return float("inf")

    return float(
        np.hypot(
            projected[0] - px,
            projected[1] - py
        )
    )


def pixel_to_main_ray(
    calib: CameraCalib,
    px: float,
    py: float
) -> Tuple[np.ndarray, np.ndarray]:

    """
    Convert a camera pixel into a calibrated viewing ray expressed
    in MAIN coordinates.
    """

    pixel = np.array(
        [
            px,
            py,
            1.0
        ],
        dtype=np.float64
    )

    K = np.array(
        [
            [calib.fx, 0.0, calib.cx],
            [0.0, calib.fy, calib.cy],
            [0.0, 0.0, 1.0],
        ],
        dtype=np.float64,
    )

    try:

        direction_camera = np.linalg.solve(
            K,
            pixel
        )

    except np.linalg.LinAlgError:

        return (
            calib.center_main.copy(),
            np.array(
                [0.0, 0.0, 1.0],
                dtype=np.float64
            )
        )

    direction_main = (
        calib.R @ direction_camera
    )

    norm = np.linalg.norm(
        direction_main
    )

    if norm < 1e-9:

        return (
            calib.center_main.copy(),
            np.array(
                [0.0, 0.0, 1.0],
                dtype=np.float64
            )
        )

    direction_main /= norm

    return (
        calib.center_main.copy(),
        direction_main
    )


def project_point_onto_ray(
    point_main: np.ndarray,
    ray_origin_main: np.ndarray,
    ray_direction_main: np.ndarray
) -> np.ndarray:

    direction = ray_direction_main

    denom = float(
        np.dot(
            direction,
            direction
        )
    )

    if denom < 1e-12:
        return point_main.copy()

    t = float(
        np.dot(
            point_main - ray_origin_main,
            direction
        ) / denom
    )

    t = max(
        0.0,
        t
    )

    return (
        ray_origin_main
        + t * direction
    )


def refine_point_with_mono_views(
    point_main: np.ndarray,
    mono_observations,
    blend: float = 0.65
) -> Tuple[np.ndarray, float, int]:

    """
    Keep ZED XYZ as the primary point.

    Mono observations provide calibrated viewing rays. The existing ZED
    point is projected onto those rays, and the resulting correction is
    blended into the ZED point.

    MediaPipe relative Z is never used.
    """

    if (
        point_main is None
        or not mono_observations
    ):
        return (
            point_main,
            0.0,
            0
        )

    blend = float(
        np.clip(
            blend,
            0.0,
            1.0
        )
    )

    candidates = []
    correction_distances = []

    for observation in mono_observations:

        calib = observation["calib"]

        px = observation["px"]
        py = observation["py"]

        try:

            ray_origin, ray_direction = (
                pixel_to_main_ray(
                    calib,
                    px,
                    py
                )
            )

            projected = (
                project_point_onto_ray(
                    point_main,
                    ray_origin,
                    ray_direction
                )
            )

        except Exception:
            continue

        if not np.all(
            np.isfinite(projected)
        ):
            continue

        distance = float(
            np.linalg.norm(
                projected - point_main
            )
        )

        candidates.append(
            projected
        )

        correction_distances.append(
            distance
        )

    if not candidates:

        return (
            point_main,
            0.0,
            0
        )

    target = np.mean(
        np.asarray(
            candidates
        ),
        axis=0
    )

    refined = (
        (1.0 - blend) * point_main
        + blend * target
    )

    avg_correction = float(
        np.mean(
            correction_distances
        )
    )

    return (
        refined,
        avg_correction,
        len(candidates)
    )


def get_zed_xyz_point(
    lm,
    detection: dict
) -> Optional[np.ndarray]:

    """
    Get a metric 3D point directly from ZED's XYZ measurement.

    ZED is configured with UNIT.METER, so the returned point is meters.

    This is the PRIMARY 3D source.

    MediaPipe's landmark.z is NEVER used.
    """

    xyz = detection.get("xyz")

    if xyz is None:
        return None

    if not isinstance(xyz, np.ndarray):
        xyz = np.asarray(
            xyz,
            dtype=np.float32
        )

    if xyz.ndim != 3:
        return None

    h_xyz, w_xyz = xyz.shape[:2]

    w = int(
        detection["w"]
    )

    h = int(
        detection["h"]
    )

    if (
        w <= 0
        or h <= 0
        or w_xyz <= 0
        or h_xyz <= 0
    ):
        return None

    px = float(lm.x) * w
    py = float(lm.y) * h

    if not (
        np.isfinite(px)
        and np.isfinite(py)
    ):
        return None

    # The retrieved XYZ map corresponds to the retrieved left image.
    ix = int(
        round(
            px * w_xyz / float(w)
        )
    )

    iy = int(
        round(
            py * h_xyz / float(h)
        )
    )

    ix = int(
        np.clip(
            ix,
            0,
            w_xyz - 1
        )
    )

    iy = int(
        np.clip(
            iy,
            0,
            h_xyz - 1
        )
    )

    # -------------------------------------------------------------
    # First try the exact landmark pixel.
    # -------------------------------------------------------------

    point = xyz[iy, ix, :3]

    if (
        np.all(np.isfinite(point))
        and np.linalg.norm(point) > 1e-6
    ):
        point_camera = np.asarray(
            point,
            dtype=np.float64
        )

        point_main = (
            detection["calib"].R
            @ point_camera
            + detection["calib"].T.reshape(3)
        )

        if np.all(
            np.isfinite(point_main)
        ):
            return point_main

    # -------------------------------------------------------------
    # Fingertips and hand edges can land on invalid stereo pixels.
    # Search a small neighborhood.
    # -------------------------------------------------------------

    radius = 3

    valid_points = []

    x0 = max(
        0,
        ix - radius
    )

    x1 = min(
        w_xyz,
        ix + radius + 1
    )

    y0 = max(
        0,
        iy - radius
    )

    y1 = min(
        h_xyz,
        iy + radius + 1
    )

    patch = xyz[
        y0:y1,
        x0:x1,
        :3
    ]

    flat = patch.reshape(
        -1,
        3
    )

    for p in flat:

        if not np.all(
            np.isfinite(p)
        ):
            continue

        if np.linalg.norm(p) <= 1e-6:
            continue

        valid_points.append(
            p
        )

    if not valid_points:
        return None

    point_camera = np.median(
        np.asarray(
            valid_points,
            dtype=np.float64
        ),
        axis=0
    )

    point_main = (
        detection["calib"].R
        @ point_camera
        + detection["calib"].T.reshape(3)
    )

    if not np.all(
        np.isfinite(point_main)
    ):
        return None

    return point_main


def observation_quality(
    lm,
    x: float,
    y: float,
    width: int,
    height: int,
) -> float:

    if not (
        np.isfinite(x)
        and np.isfinite(y)
    ):
        return 0.0

    if (
        x < 0
        or y < 0
        or x >= width
        or y >= height
    ):
        return 0.0

    visibility = float(
        getattr(
            lm,
            "visibility",
            1.0
        )
    )

    presence = float(
        getattr(
            lm,
            "presence",
            1.0
        )
    )

    return (
        max(
            0.0,
            min(
                1.0,
                visibility
            )
        )
        *
        max(
            0.0,
            min(
                1.0,
                presence
            )
        )
    )


def fuse_landmark(
    observations,
    min_angle_deg: float,
    reproj_threshold_px: float
):

    """
    Multi-view fallback.

    This is ONLY used when the MAIN ZED camera cannot provide a valid
    XYZ point for the landmark.

    Requires at least two camera observations.

    MediaPipe relative Z is never used.
    """

    if len(observations) < 2:

        return (
            None,
            [],
            "insufficient_views"
        )

    active = list(
        observations
    )

    while len(active) >= 3:

        worst_idx = None
        worst_error = -1.0

        for i, candidate in enumerate(
            active
        ):

            others = (
                active[:i]
                + active[i + 1:]
            )

            point = triangulate_point(
                others
            )

            if point is None:
                continue

            err = reprojection_error_px(
                candidate[0],
                candidate[1],
                candidate[2],
                point
            )

            if err > worst_error:

                worst_error = err
                worst_idx = i

        if (
            worst_idx is None
            or worst_error <= reproj_threshold_px
        ):
            break

        active.pop(
            worst_idx
        )

    if len(active) < 2:

        return (
            None,
            [],
            "no_consistent_pair"
        )

    point = triangulate_point(
        active
    )

    if point is None:

        return (
            None,
            [],
            "triangulation_failed"
        )

    if not np.all(
        np.isfinite(point)
    ):

        return (
            None,
            [],
            "invalid_point"
        )

    centers = [
        camera_center_from_projection(
            obs[0]
        )
        for obs in active
    ]

    angle = triangulation_angle_deg(
        point,
        centers
    )

    if angle < min_angle_deg:

        return (
            None,
            [],
            f"weak_geometry_{angle:.2f}deg"
        )

    errors = [
        (
            obs[3],
            reprojection_error_px(
                obs[0],
                obs[1],
                obs[2],
                point
            )
        )
        for obs in active
    ]

    return (
        point,
        errors,
        "triangulated"
    )


