class CameraWorker:

    """
    Each camera has two threads:

      Capture thread:
          captures the newest camera frame and, for MAIN,
          retrieves ZED XYZ.

      MediaPipe thread:
          always consumes the newest captured frame.

    No MediaPipe backlog is allowed to accumulate.
    """

    def __init__(
        self,
        zed_sl,
        cv2_module,
        mp_hands_module,
        serial_number,
        calib,
        resolution,
        fps,
        max_hands,
        min_det_conf,
        min_track_conf,
        detect_width,
        model_complexity
    ):

        self.sl = zed_sl
        self.cv2 = cv2_module
        self.mp_hands_module = mp_hands_module

        self.serial_number = serial_number
        self.calib = calib

        self.detect_width = detect_width

        self.is_main = (
            calib.name == "main"
        )

        # ---------------------------------------------------------
        # Initialize the correct ZED camera type.
        # ---------------------------------------------------------

        if self.is_main:

            init_params = (
                self.sl.InitParameters()
            )

        else:

            init_params = (
                self.sl.InitParametersOne()
            )

        init_params.camera_resolution = (
            resolution
        )

        init_params.camera_fps = (
            fps
        )

        init_params.coordinate_units = (
            self.sl.UNIT.METER
        )

        init_params.input.set_from_serial_number(
            serial_number
        )

        # ---------------------------------------------------------
        # MAIN camera:
        #
        # ZED metric 3D is ALWAYS enabled.
        # No command-line flag is needed.
        # ---------------------------------------------------------

        if self.is_main:

            init_params.depth_mode = (
                self.sl.DEPTH_MODE.NEURAL
            )

        self.cam = (
            self.sl.Camera()
            if self.is_main
            else self.sl.CameraOne()
        )

        status = self.cam.open(
            init_params
        )

        if status != (
            self.sl.ERROR_CODE.SUCCESS
        ):

            raise RuntimeError(
                f"Failed to open camera "
                f"SN={serial_number} "
                f"({calib.name}): "
                f"{status}"
            )

        # ---------------------------------------------------------
        # Read camera intrinsics.
        # ---------------------------------------------------------

        calib_params = (
            self.cam
            .get_camera_information()
            .camera_configuration
            .calibration_parameters
        )

        if self.is_main:

            left_cam = (
                calib_params.left_cam
            )

            calib.fx = left_cam.fx
            calib.fy = left_cam.fy
            calib.cx = left_cam.cx
            calib.cy = left_cam.cy

        else:

            calib.fx = calib_params.fx
            calib.fy = calib_params.fy
            calib.cx = calib_params.cx
            calib.cy = calib_params.cy

        # ---------------------------------------------------------
        # MAIN camera uses RuntimeParameters.
        #
        # CameraOne uses its own grab() path.
        # ---------------------------------------------------------

        self.runtime_params = (
            self.sl.RuntimeParameters()
            if self.is_main
            else None
        )

        self.image_mat = (
            self.sl.Mat()
        )

        # ZED XYZ point cloud.
        #
        # This is allocated ONLY for MAIN because the mono cameras
        # do not provide stereo depth.
        self.xyz_mat = (
            self.sl.Mat()
            if self.is_main
            else None
        )

        self.hands = (
            self.mp_hands_module.Hands(
                static_image_mode=False,
                max_num_hands=max_hands,
                min_detection_confidence=min_det_conf,
                min_tracking_confidence=min_track_conf,
                model_complexity=model_complexity
            )
        )

        self._frame_lock = (
            threading.Lock()
        )

        self._result_lock = (
            threading.Lock()
        )

        self._latest_frame = None

        self._latest_result = {
            "frame_bgr": None,
            "xyz": None,
            "results": None,
            "frame_w": None,
            "frame_h": None,
            "capture_ts": 0.0,
            "processed_ts": 0.0,
            "frame_id": -1
        }

        self._new_frame = (
            threading.Event()
        )

        self._stop_flag = (
            threading.Event()
        )

        self._capture_thread = (
            threading.Thread(
                target=self._capture_loop,
                name=f"ZED-Capture-{serial_number}",
                daemon=True
            )
        )

        self._tracking_thread = (
            threading.Thread(
                target=self._tracking_loop,
                name=f"MediaPipe-{serial_number}",
                daemon=True
            )
        )

        self.capture_fps = 0.0
        self.tracking_fps = 0.0

        self._capture_count = 0
        self._capture_start = (
            time.monotonic()
        )

        self._tracking_count = 0
        self._tracking_start = (
            time.monotonic()
        )

        self.frame_id = 0

    def start(self):

        self._capture_thread.start()
        self._tracking_thread.start()

    def _capture_loop(self):

        cv2 = self.cv2

        while not self._stop_flag.is_set():

            # -----------------------------------------------------
            # Every camera must grab a new frame before retrieval.
            # -----------------------------------------------------

            try:

                if self.is_main:

                    status = self.cam.grab(
                        self.runtime_params
                    )

                else:

                    # CameraOne acquisition.
                    status = self.cam.grab()

            except Exception as e:

                print(
                    f"[CAPTURE ERROR] "
                    f"SN={self.serial_number} "
                    f"({self.calib.name}): "
                    f"{e}"
                )

                time.sleep(0.01)

                continue

            if status != (
                self.sl.ERROR_CODE.SUCCESS
            ):

                continue

            # -----------------------------------------------------
            # Retrieve image.
            # -----------------------------------------------------

            try:

                if self.is_main:

                    image_status = (
                        self.cam.retrieve_image(
                            self.image_mat,
                            self.sl.VIEW.LEFT
                        )
                    )

                else:

                    image_status = (
                        self.cam.retrieve_image(
                            self.image_mat
                        )
                    )

            except Exception as e:

                print(
                    f"[IMAGE ERROR] "
                    f"SN={self.serial_number} "
                    f"({self.calib.name}): "
                    f"{e}"
                )

                continue

            if image_status not in (
                None,
                self.sl.ERROR_CODE.SUCCESS
            ):

                continue

            frame_bgra = (
                self.image_mat.get_data()
            )

            if frame_bgra is None:
                continue

            if frame_bgra.ndim != 3:
                continue

            # ZED images normally arrive as BGRA.
            if frame_bgra.shape[2] == 4:

                frame_bgr = cv2.cvtColor(
                    frame_bgra,
                    cv2.COLOR_BGRA2BGR
                )

            elif frame_bgra.shape[2] == 3:

                frame_bgr = frame_bgra.copy()

            else:

                continue

            h, w = (
                frame_bgr.shape[:2]
            )

            xyz = None

            # -----------------------------------------------------
            # MAIN ZED:
            #
            # Retrieve actual XYZ point cloud.
            #
            # This is our metric depth source.
            # -----------------------------------------------------

            if (
                self.is_main
                and self.xyz_mat is not None
            ):

                try:

                    xyz_status = (
                        self.cam.retrieve_measure(
                            self.xyz_mat,
                            self.sl.MEASURE.XYZ
                        )
                    )

                    if xyz_status in (
                        None,
                        self.sl.ERROR_CODE.SUCCESS
                    ):

                        xyz_data = (
                            self.xyz_mat.get_data()
                        )

                        if (
                            xyz_data is not None
                            and xyz_data.ndim == 3
                            and xyz_data.shape[2] >= 3
                        ):

                            xyz = (
                                np.asarray(
                                    xyz_data[
                                        ...,
                                        :3
                                    ],
                                    dtype=np.float32
                                ).copy()
                            )

                except Exception as e:

                    print(
                        f"[ZED XYZ ERROR] "
                        f"SN={self.serial_number}: "
                        f"{e}"
                    )

                    xyz = None

            capture_ts = (
                time.monotonic()
            )

            frame_copy = (
                frame_bgr.copy()
            )

            with self._frame_lock:

                self._latest_frame = {
                    "frame_bgr": frame_copy,
                    "xyz": xyz,
                    "frame_w": w,
                    "frame_h": h,
                    "capture_ts": capture_ts,
                    "frame_id": self.frame_id
                }

                self.frame_id += 1

            self._new_frame.set()

            self._capture_count += 1

            if self._capture_count >= 30:

                elapsed = (
                    time.monotonic()
                    - self._capture_start
                )

                self.capture_fps = (
                    self._capture_count / elapsed
                    if elapsed > 0
                    else 0.0
                )

                self._capture_count = 0

                self._capture_start = (
                    time.monotonic()
                )

    def _tracking_loop(self):

        cv2 = self.cv2

        try:

            while not self._stop_flag.is_set():

                self._new_frame.wait(
                    timeout=0.05
                )

                if self._stop_flag.is_set():
                    break

                with self._frame_lock:

                    frame_data = (
                        self._latest_frame
                    )

                    self._new_frame.clear()

                if frame_data is None:
                    continue

                frame_bgr = (
                    frame_data["frame_bgr"]
                )

                h, w = (
                    frame_bgr.shape[:2]
                )

                if (
                    self.detect_width
                    and w > self.detect_width
                ):

                    scale = (
                        self.detect_width
                        / float(w)
                    )

                    small = cv2.resize(
                        frame_bgr,
                        (
                            self.detect_width,
                            int(h * scale)
                        )
                    )

                else:

                    small = frame_bgr

                small_rgb = (
                    cv2.cvtColor(
                        small,
                        cv2.COLOR_BGR2RGB
                    )
                )

                results = (
                    self.hands.process(
                        small_rgb
                    )
                )

                with self._result_lock:

                    self._latest_result = {
                        "frame_bgr": frame_bgr,
                        "xyz": frame_data["xyz"],
                        "results": results,
                        "frame_w": w,
                        "frame_h": h,
                        "capture_ts": frame_data["capture_ts"],
                        "processed_ts": time.monotonic(),
                        "frame_id": frame_data["frame_id"]
                    }

                self._tracking_count += 1

                if self._tracking_count >= 30:

                    elapsed = (
                        time.monotonic()
                        - self._tracking_start
                    )

                    self.tracking_fps = (
                        self._tracking_count / elapsed
                        if elapsed > 0
                        else 0.0
                    )

                    self._tracking_count = 0

                    self._tracking_start = (
                        time.monotonic()
                    )

        except Exception as e:

            import traceback

            print(
                f"[MediaPipe ERROR] "
                f"SN={self.serial_number} "
                f"({self.calib.name}): "
                f"{e}"
            )

            traceback.print_exc()

    def get_latest_frame(self):

        with self._frame_lock:

            if self._latest_frame is None:
                return None

            return dict(
                self._latest_frame
            )

    def get_latest(self):

        with self._result_lock:

            return dict(
                self._latest_result
            )

    def stop(self):

        self._stop_flag.set()
        self._new_frame.set()

    def join(self, timeout=None):

        self._capture_thread.join(
            timeout=timeout
        )

        self._tracking_thread.join(
            timeout=timeout
        )

    def close(self):

        try:
            self.hands.close()
        except Exception:
            pass

        try:
            self.cam.close()
        except Exception:
            pass


def build_finger_dict(
    points3d,
    landmark_sources=None
):

    if points3d is None:
        return None

    out = {}

    for finger, indices in FINGER_GROUPS.items():

        finger_points = []

        for i in indices:

            point = points3d[i]

            if point is None:

                finger_points.append(
                    None
                )

                continue

            entry = {
                "xyz": [
                    round(
                        float(point[0]),
                        4
                    ),
                    round(
                        float(point[1]),
                        4
                    ),
                    round(
                        float(point[2]),
                        4
                    )
                ]
            }

            if landmark_sources is not None:

                entry["source"] = (
                    landmark_sources[i]
                )

            finger_points.append(
                entry
            )

        out[finger] = finger_points

    return out


